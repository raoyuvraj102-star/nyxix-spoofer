    function window:SelectTab(name)
        for n, t in pairs(window._tabs) do
            t.content.Visible = n == name
            window._ui:Tween(t.button, {
                BackgroundColor3 = n == name and currentTheme.AccentDark or currentTheme.Background,
                TextColor3 = n == name and currentTheme.Text or currentTheme.TextMuted,
                BackgroundTransparency = n == name and 0 or 0.5,
            })
        end
        window._activeTab = name
    end

    function window:Toggle()
        window._visible = not window._visible
        window._main.Visible = window._visible
    end

    function window:Destroy()
        window._trove:Destroy()
    end

    return window
end

-- Tooltip system
function UI:AttachTooltip(parent, text)
    parent.MouseEnter:Connect(function()
        if self._activeTooltip then self._activeTooltip:Destroy() end
        local tooltip = self:CreateFrame({
            Size = UDim2.fromOffset(0, 28),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = currentTheme.Background,
            BorderSizePixel = 0,
            ZIndex = 100,
            Parent = self._overlay,
        })
        self._trove:Add(self:CreateUICorner(6)):SetParent(tooltip)
        self:CreateUIStroke(currentTheme.Border, 1):SetParent(tooltip)
        self:CreateUIPadding({PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4)}):SetParent(tooltip)
        local label = self:CreateTextLabel({
            Text = text,
            FontFace = Fonts.Medium,
            TextSize = 13,
            TextColor3 = currentTheme.Text,
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.XY,
            Parent = tooltip,
        })
        self._activeTooltip = tooltip
        task.spawn(function()
            while tooltip.Parent do
                local pos = UserInputService:GetMouseLocation()
                tooltip.Position = UDim2.fromOffset(pos.X + 16, pos.Y + 16)
                task.wait()
            end
        end)
    end)
    parent.MouseLeave:Connect(function()
        if self._activeTooltip then self._activeTooltip:Destroy(); self._activeTooltip = nil end
    end)
