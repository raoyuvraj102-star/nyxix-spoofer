-- Handle script re-execution
if getgenv().NyxixSpoofer then
    getgenv().NyxixSpoofer:Destroy()
end

local NyxixSpoofer = {
    UI = ui,
    Spoofer = spoofer,
    Config = Config,
    ConfigManager = configManager,
    Window = mainWindow,
    Theme = currentTheme,
    Version = CONFIG_VERSION,

    Start = function() spoofer:Start() end,
    Stop = function() spoofer:Stop() end,
    Toggle = function() spoofer:Toggle() end,
    SetConfig = function(cfg) for k, v in pairs(cfg) do Config[k] = v end; configManager:Save() end,
    GetConfig = function() return Config end,
    LoadProfile = function(name) return configManager:LoadProfile(name) end,
    SaveProfile = function(name) configManager:SaveProfile(name) end,
    DeleteProfile = function(name) configManager:DeleteProfile(name) end,
    ListProfiles = function() return configManager:ListProfiles() end,
    Destroy = function()
        spoofer:Stop()
        ui._trove:Destroy()
        if keybindConnection then keybindConnection:Disconnect() end
        getgenv().NyxixSpoofer = nil
    end,
}

getgenv().NyxixSpoofer = NyxixSpoofer

-- Notify ready
ui:Notify("Nyxix Spoofer v" .. CONFIG_VERSION .. " loaded! Press " .. Config.Keybind .. " to toggle")

return NyxixSpoofer
