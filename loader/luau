local CONFIG_DIR = "NyxixSpoofer"
local CONFIG_FILE = CONFIG_DIR .. "/config.json"
local CONFIG_VERSION = 5

local function ensureDirs()
    if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
    if not isfolder(CONFIG_DIR .. "/configs") then makefolder(CONFIG_DIR .. "/configs") end
end

local function saveConfig(cfg, path)
    ensureDirs()
    local fullPath = path or (CONFIG_DIR .. "/config.json")
    writefile(fullPath, HttpService:JSONEncode(cfg))
end

local function loadConfig(path)
    local fullPath = path or (CONFIG_DIR .. "/config.json")
    if isfile(fullPath) then
        local ok, cfg = pcall(HttpService.JSONDecode, HttpService, readfile(fullPath))
        if ok and type(cfg) == "table" then return cfg end
    end
    return nil
end

local function listConfigs()
    ensureDirs()
    local list = {}
    for _, f in ipairs(listfiles(CONFIG_DIR .. "/configs")) do
        if isfile(f) then
            local name = f:match("([^/\\]+)%.json$")
            if name then table.insert(list, name) end
        end
    end
    return list
end

local function deleteConfig(name)
    local path = CONFIG_DIR .. "/configs/" .. name .. ".json"
    if isfile(path) then delfile(path) end
end

