-- Config Manager with Migrations
local ConfigManager = {}
ConfigManager.__index = ConfigManager

function ConfigManager.new(default, version, dir)
    local self = setmetatable({
        _data = deepCopy(default),
        _default = deepCopy(default),
        _version = version,
        _dir = dir,
        _migrations = {},
    }, ConfigManager)
    return self
end

function ConfigManager:Migrate(version, data)
    while version < self._version do
        local mig = self._migrations[version]
        if not mig then break end
        data = mig(data, version, version + 1)
        version = version + 1
    end
    return data
end

function ConfigManager:Load()
    local raw = loadConfig(self._dir .. "/config.json")
    if raw then
        local version = raw.Version or 1
        if version ~= self._version then
            raw = self:Migrate(version, raw)
        end
        self._data = raw
    else
        self._data = deepCopy(self._data)
        self:Save()
    end
    return self._data
end

function ConfigManager:Save()
    self._data.Version = self._version
    saveConfig(self._data)
end

function ConfigManager:Get(path)
    return navigateTo(self._data, keyToPath(path))
end

function ConfigManager:Set(path, value)
    setNested(self._data, keyToPath(path), value)
    self:Save()
end

function ConfigManager:GetAll() return deepCopy(self._data) end

function ConfigManager:LoadProfile(name)
    local cfg = loadConfig(CONFIG_DIR .. "/configs/" .. name .. ".json")
    if cfg then
        self._data = cfg
        self:Save()
        return true
    end
    return false
end

function ConfigManager:SaveProfile(name)
    ensureDirs()
    saveConfig(self._data, CONFIG_DIR .. "/configs/" .. name .. ".json")
end

function ConfigManager:DeleteProfile(name)
    deleteConfig(name)
end

function ConfigManager:ListProfiles() return listConfigs() end

