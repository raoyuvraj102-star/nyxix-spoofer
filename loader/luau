-- ========== MAIN CONTROL ==========
function Spoofer:Start()
    if self._running then return end
    self._running = true

    -- Hook LocalPlayer
    self:_hookPlayer(Players.LocalPlayer, true)

    -- Hook existing players
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            self:_hookPlayer(player, false)
        end
    end

    -- Hook new players
    self._trove:Connect(Players.PlayerAdded, function(player)
        self:_hookPlayer(player, false)
    end)

    self._trove:Connect(Players.PlayerRemoving, function(player)
        local trove = self._charConns[player]
        if trove then trove:Destroy(); self._charConns[player] = nil end
        local ctrove = self._charConns[player]
        if ctrove then ctrove:Destroy(); self._charConns[player] = nil end
    end)

    -- Advanced hooks
    if Config.Advanced.SpoofViewModel then self:_hookViewModel() end
    if Config.Advanced.SpoofDuelCharacters then self:_hookDuelCharacters() end
    if Config.Advanced.SpoofCosmeticMenus then self:_hookCosmeticMenus() end
    if Config.Advanced.SpoofProjectiles then self:_hookProjectiles() end
    if Config.Advanced.SpoofFinishers then self:_hookFinishers() end

    -- Apply chams to existing characters
    if Config.Advanced.EnableChams then
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then self:_applyChams(player.Character, player == Players.LocalPlayer) end
        end
    end

    ui:Notify("Nyxix Spoofer started")
end

function Spoofer:Stop()
    if not self._running then return end
    self._running = false

    self._trove:Destroy()
    self._trove = Trove.new("Spoofer")
    self._guiConns:Destroy(); self._guiConns = Trove.new()
    self._viewModelConns:Destroy(); self._viewModelConns = Trove.new()
    self._duelConns:Destroy(); self._duelConns = Trove.new()
    self._cosmeticConns:Destroy(); self._cosmeticConns = Trove.new()
    self._projectileConns:Destroy(); self._projectileConns = Trove.new()
    self._finisherConns:Destroy(); self._finisherConns = Trove.new()

    for _, trove in pairs(self._charConns) do trove:Destroy() end
    table.clear(self._charConns)

    -- Remove chams
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then self:_removeChams(player.Character) end
    end

    ui:Notify("Nyxix Spoofer stopped")
end

function Spoofer:Toggle()
    Config.Enabled = not Config.Enabled
    configManager:Set("Enabled", Config.Enabled)
    if Config.Enabled then self:Start() else self:Stop() end
end

function Spoofer:_hookPlayer(player, isLocal)
    if player == Players.LocalPlayer and not isLocal then return end
    local trove = Trove.new()
    self._charConns[player] = trove

    trove:Connect(player.CharacterAdded, function(char)
        self:_onCharacterAdded(player, char, isLocal)
    end)

    if player.Character then
        trove:Add(task.spawn(function() self:_onCharacterAdded(player, player.Character, isLocal) end))
    end
end

