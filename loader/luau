-- ========== CHARACTER APPEARANCE ==========
function Spoofer:_onCharacterAdded(player, character, isLocal)
    if not Config.Enabled then return end
    local profile = isLocal and Config.LocalPlayer or Config.OtherPlayers
    if not profile.Enabled then return end
    local spoofedNames = self:_getSpoofedNames(player, isLocal)
    local spoofedAvatarId = profile.Avatar.Enabled and profile.Avatar.Value or nil
    if not spoofedNames and not spoofedAvatarId then return end

    local trove = self._charConns[player] or Trove.new()
    self._charConns[player] = trove

    local humanoid = character:WaitForChild("Humanoid", 10)
    local hrp = character:WaitForChild("HumanoidRootPart", 10)
    if not humanoid or not hrp then return end

    if spoofedAvatarId then
        local desc = self:_fetchHumanoidDescription(spoofedAvatarId)
        task.defer(function()
            if character.Parent then self:_applyHumanoidDescription(character, desc) end
        end)
    end

    if spoofedNames then trove:Add(task.spawn(function() self:_hookGuiNames(player, isLocal) end)) end
    if spoofedAvatarId then trove:Add(task.spawn(function() self:_hookGuiThumbnails(player, spoofedAvatarId) end)) end

    -- Chams
    if Config.Advanced.EnableChams then
        self:_applyChams(character, isLocal)
    end
end

-- ========== CHAMS SYSTEM ==========
function Spoofer:_applyChams(character, isLocal)
    if not character then return end
    local trove = self._charConns[character] or Trove.new()
    self._charConns[character] = trove

    local chamsColor = deserializeColor(Config.Advanced.ChamsColor)
    local outlineColor = deserializeColor(Config.Advanced.ChamsOutlineColor)

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            -- Highlight
            local highlight = Instance.new("Highlight")
            highlight.Name = "NyxixCham"
            highlight.FillColor = chamsColor
            highlight.FillTransparency = Config.Advanced.ChamsTransparency
            highlight.OutlineColor = outlineColor
            highlight.OutlineTransparency = Config.Advanced.ChamsOutlineTransparency
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Adornee = part
            highlight.Parent = part
            trove:Add(highlight)

            -- Force material
            part.Material = Enum.Material.ForceField
            part.Color = chamsColor
            part.Transparency = Config.Advanced.ChamsTransparency
        end
    end
end

function Spoofer:_removeChams(character)
    local trove = self._charConns[character]
    if trove then trove:Destroy() self._charConns[character] = nil end
    if character then
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("Highlight") and obj.Name == "NyxixCham" then obj:Destroy() end
        end
    end
end

-- ========== VIEWMODEL SPOOFING ==========
function Spoofer:_hookViewModel()
    if not Config.Advanced.SpoofViewModel then return end
    local camera = Workspace.CurrentCamera
    if not camera then return end

    local function processViewModel(vm)
        if not vm or not vm:IsA("Model") then return end
        if vm.Name ~= "ViewModel" and vm.Name ~= "Arms" then return end

        local profile = Config.LocalPlayer
        if profile.Enabled and profile.Avatar.Enabled and profile.Avatar.Value then
            local desc = self:_fetchHumanoidDescription(profile.Avatar.Value)
            for _, part in ipairs(vm:GetDescendants()) do
                if part:IsA("BasePart") and (part.Name:lower():find("arm") or part.Name:lower():find("hand")) then
                    if desc.HeadColor then
                        part.Color = Color3.new(desc.HeadColor.R, desc.HeadColor.G, desc.HeadColor.B)
                    end
                    part.Material = Enum.Material.ForceField
                end
            end
        end
    end

    self._viewModelConns:Connect(camera.ChildAdded, function(child)
        task.defer(function() processViewModel(child) end)
    end)

    for _, child in ipairs(camera:GetChildren()) do
        task.defer(function() processViewModel(child) end)
    end
end

