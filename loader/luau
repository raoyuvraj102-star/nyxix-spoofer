-- Trove (Resource Management)
local Trove = {}
Trove.__index = Trove
function Trove.new(name) return setmetatable({_name = name, _items = {}}, Trove) end
local function cleanItem(o)
    local t = typeof(o)
    if t == "RBXScriptConnection" then o:Disconnect()
    elseif t == "Instance" then pcall(function() o:Destroy() end)
    elseif t == "thread" then pcall(task.cancel, o)
    elseif type(o) == "function" then pcall(o)
    elseif type(o) == "table" then
        local function member(k) local ok, v = pcall(function() return o[k] end); return ok and type(v) == "function" and v or nil end
        local cancel, getStatus = member("cancel"), member("getStatus")
        if cancel and getStatus then pcall(cancel, o); return end
        local destroy = member("Destroy"); if destroy then pcall(destroy, o); return end
        local disconnect = member("Disconnect"); if disconnect then pcall(disconnect, o) end
    end
end
function Trove:Add(o) table.insert(self._items, o); return o end
function Trove:Connect(sig, fn) return self:Add(sig:Connect(fn)) end
function Trove:Extend() return self:Add(Trove.new(self._name)) end
function Trove:Remove(o, keep) local i = table.find(self._items, o); if i then table.remove(self._items, i); if not keep then cleanItem(o) end end end
function Trove:Clean() local items = self._items; self._items = {}; for i = #items, 1, -1 do cleanItem(items[i]) end end
Trove.Destroy = Trove.Clean

-- Signal
local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({_handlers = {}}, Signal) end
function Signal:Connect(fn)
    local h = {fn = fn, connected = true}; table.insert(self._handlers, h)
    return {Connected = true, Disconnect = function() h.connected = false end}
end
function Signal:Fire(...) for _, h in ipairs(self._handlers) do if h.connected then task.spawn(h.fn, ...) end end end
function Signal:Destroy() table.clear(self._handlers) end

-- Deep copy
local function deepCopy(t)
    if type(t) ~= "table" then return t end
    local copy = {}; for k, v in pairs(t) do copy[k] = deepCopy(v) end; return setmetatable(copy, getmetatable(t))
end

-- Path utilities
local function pathToKey(p) return table.concat(p, ".") end
local function keyToPath(k) return k:split(".") end
local function navigateTo(t, p, create)
    for i = 1, #p do
        local k = p[i]
        if i == #p then return t[k] end
        if t[k] == nil then if create then t[k] = {} else return nil end
        elseif type(t[k]) ~= "table" then return nil end
        t = t[k]
    end
end
local function setNested(t, p, v)
    for i = 1, #p do local k = p[i]; if i == #p then t[k] = v; return end; if t[k] == nil then t[k] = {} end; t = t[k] end
end

-- Color serialization
local function serializeColor(c) return {__type = "Color3", R = c.R, G = c.G, B = c.B} end
local function deserializeColor(t) return Color3.new(t.R, t.G, t.B) end

