-- ========== AVATAR FETCHING ==========
function Spoofer:_fetchHumanoidDescription(userId)
    if self._descCache[userId] then return self._descCache[userId] end
    local success, desc = pcall(function()
        return Players:GetHumanoidDescriptionFromUserIdAsync(userId)
    end)
    if success and desc then
        self._descCache[userId] = desc
        return desc
    end
    return Instance.new("HumanoidDescription")
end

function Spoofer:_applyHumanoidDescription(character, desc)
    if not character or not character.Parent then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    pcall(function() humanoid:ApplyDescription(desc) end)
end

-- ========== NAME SPOOFING ==========
function Spoofer:_getSpoofedNames(player, isLocal)
    local profile = isLocal and Config.LocalPlayer or Config.OtherPlayers
    if not profile.Enabled then return nil end
    local name = (profile.Name.Enabled and profile.Name.Value ~= "") and profile.Name.Value or nil
    local display = (profile.DisplayName.Enabled and profile.DisplayName.Value ~= "") and profile.DisplayName.Value or nil
    if name or display then return {Name = name, DisplayName = display} end
    return nil
end

function Spoofer:_patchTextObject(textObj, player, isLocal)
    if not textObj or not textObj.Parent then return end
    local spoofed = self:_getSpoofedNames(player, isLocal)
    if not spoofed then return end
    local original = textObj.Text
    local modified = original
    if spoofed.Name and original:find(player.Name, 1, true) then modified = modified:gsub(player.Name, spoofed.Name) end
    if spoofed.DisplayName and original:find(player.DisplayName, 1, true) then modified = modified:gsub(player.DisplayName, spoofed.DisplayName) end
    if modified ~= original then textObj.Text = modified end
end

function Spoofer:_scanGuiForNames(gui, player, isLocal)
    if not gui then return end
    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            self:_patchTextObject(obj, player, isLocal)
        end
    end
end

function Spoofer:_hookGuiNames(player, isLocal)
    local playerGui = player:WaitForChild("PlayerGui", 10)
    if not playerGui then return end
    local trove = self._charConns[player] or Trove.new()
    self._charConns[player] = trove
    task.spawn(function() self:_scanGuiForNames(playerGui, player, isLocal) end)
    trove:Connect(playerGui.DescendantAdded, function(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            task.defer(function() self:_patchTextObject(obj, player, isLocal) end)
        end
    end)
end

-- ========== THUMBNAIL SPOOFING ==========
function Spoofer:_patchThumbnail(imageObj, spoofedUserId)
    if not imageObj or not imageObj.Parent then return end
    local img = imageObj.Image
    if not img or img == "" then return end
    local newImg = img:gsub("id=%d+", "id=" .. spoofedUserId)
                        :gsub("userId=%d+", "userId=" .. spoofedUserId)
                        :gsub("/%d+(%D)", "/" .. spoofedUserId .. "%1")
    if newImg ~= img then imageObj.Image = newImg end
end

function Spoofer:_scanGuiForThumbnails(gui, spoofedUserId)
